{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Django: runserver (venv)",
      "type": "python",
      "request": "launch",
      "python": "${workspaceFolder}/venv/Scripts/python.exe",
      "program": "${workspaceFolder}/manage.py",
      "args": ["runserver", "8000", "--noreload"],
      "django": true,
      "env": {
        "DJANGO_SETTINGS_MODULE": "mysite.settings"
      },
      "console": "integratedTerminal"
    }
  ]
}
