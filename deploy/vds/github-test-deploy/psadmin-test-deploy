#!/usr/bin/env bash
set -euo pipefail

[ "$(id -u)" -eq 0 ] || { echo "must run as root" >&2; exit 1; }

base=/home/deploy/psadmin-test
releases="$base/releases"
trusted=/etc/psadmin-test
compose_file="$trusted/compose.test.yml"
archive_validator="$trusted/unpack-release.py"
lock=/run/lock/psadmin-test-deploy.lock

install -d -m 0755 "$releases"
exec 9>"$lock"
flock -n 9 || { echo "A test deploy is already running." >&2; exit 1; }

workdir=$(mktemp -d /var/tmp/psadmin-test-deploy.XXXXXX)
cleanup() { rm -rf "$workdir"; }
trap cleanup EXIT

old_release=
old_tag=
if [ -L "$base/current" ]; then
  old_release=$(readlink -f "$base/current")
  old_tag=$(cat "$old_release/.psadmin-release-tag")
  ln -sfn "$old_release" "$base/previous"
fi

started_new_release=false
on_exit() {
  status=$?
  if [ "$status" -ne 0 ] && [ "$started_new_release" = true ] && [ -n "$old_release" ]; then
    echo "New release failed; restoring the previous test-web container." >&2
    APP_RELEASE="$old_release" RELEASE_TAG="$old_tag" \
      docker compose --project-name psadmin-test -f "$compose_file" build test-web || true
    APP_RELEASE="$old_release" RELEASE_TAG="$old_tag" \
      docker compose --project-name psadmin-test -f "$compose_file" up -d test-web || true
    echo "The test database is not rolled back; migrations are intentionally never reversed automatically." >&2
  fi
  cleanup
  exit "$status"
}
trap on_exit EXIT

# The key is allowed to stream one bounded archive, not to select paths or commands.
ulimit -f 524288
cat > "$workdir/release.tar.gz"

release_tag=$(sha256sum "$workdir/release.tar.gz" | awk '{print substr($1, 1, 16)}')
release="$releases/$release_tag"
[ ! -e "$release" ] || { echo "This release is already installed." >&2; exit 1; }

python3 "$archive_validator" "$workdir/release.tar.gz" "$release"
install -d -m 0755 "$release/.deploy-trusted"
cp -a "$trusted/certs" "$release/.deploy-trusted/certs"
printf '%s\n' "$release_tag" > "$release/.psadmin-release-tag"
chmod 0644 "$release/.psadmin-release-tag"

compose() {
  APP_RELEASE="$release" RELEASE_TAG="$release_tag" \
    docker compose --project-name psadmin-test -f "$compose_file" "$@"
}

wait_healthy() {
  local status=starting container
  container=$(compose ps -q test-web)
  [ -n "$container" ] || { echo "test-web container was not created" >&2; return 1; }
  for _ in $(seq 1 30); do
    status=$(docker inspect -f '{{.State.Health.Status}}' "$container")
    [ "$status" = healthy ] && { echo "test web: healthy"; return 0; }
    sleep 3
  done
  echo "test web: $status" >&2
  compose logs --tail 50 test-web >&2
  return 1
}

compose build test-web
compose up -d test-db
compose run --rm -T test-web python manage.py migrate --noinput
started_new_release=true
compose up -d
wait_healthy

ln -sfn "$release" "$base/current"

echo "Test release $release_tag deployed."
